<div class="row mt-2" data-id="<%= txid %>">
    <div class="col-md-1 col-2 text-start"><span class="badge <%= badgeClass%>"><%=base%></span></div>
    <div class="col-md-2 col-5 text-start <%=dateClass%>" title="<%=time%>"><%=date%></div>
    <div class="col-md-1 col-2 text-start <%=statusClass%>"><%=side%></div>
    <div class="col-md-2 col-3 text-end <%=costClass%>"><%=volume%></div>
    <div class="col-md-2 col-4 text-end order-md-1 order-2 <%=costClass%>"><%=cost%></div>
    <div class="col-md-2 col-4 text-start <%=statusClass%>" title="<%=txid%>"><%=status%></div>
    <div class="col-md-2 col-4 text-start text-neutral"><%=account%></div>
</div>